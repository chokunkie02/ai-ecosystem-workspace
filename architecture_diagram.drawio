                <!-- Trainer Worker to MLflow -->
                <mxCell id="e_trainer_mlflow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#d6b656;" parent="1" source="trainer_worker" target="mlflow" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
