                <mxCell id="e_redis_trainer_lbl" value="Poll Due Training Jobs" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_redis_trainer" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
                </mxCell>

                <!-- Redis to Inference Worker -->
                <mxCell id="e_redis_inference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeWidth=2;strokeColor=#82b366;" parent="1" source="redis" target="inference_worker" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_redis_inference_lbl" value="BRPOP Task / Write Result" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_redis_inference" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
                </mxCell>

                <!-- Trainer Worker to MinIO -->
                <mxCell id="e_trainer_minio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=1.5;strokeColor=#82b366;" parent="1" source="trainer_worker" target="minio" edge="1">
                    <mxGeometry relative="1" as="geometry">
