                <!-- MLflow to MinIO -->
                <mxCell id="e_mlflow_minio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeWidth=2;strokeColor=#82b366;" parent="1" source="mlflow" target="minio" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
