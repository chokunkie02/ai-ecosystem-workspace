                <mxCell id="e_trainer_minio_lbl" value="Fetch Datasets / Upload Checkpoints" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_trainer_minio" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
