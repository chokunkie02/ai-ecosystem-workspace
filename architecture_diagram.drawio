                <mxCell id="e_trainer_mlflow_lbl" value="Log Params, Metrics &amp; Register Model" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_trainer_mlflow" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
                </mxCell>

                <!-- MLflow to PostgreSQL -->
                <mxCell id="e_mlflow_postgres" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeWidth=2;strokeColor=#23445d;" parent="1" source="mlflow" target="postgres" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
