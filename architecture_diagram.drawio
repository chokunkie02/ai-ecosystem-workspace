<mxfile host="65bd71144e">
    <diagram id="WTN-A07-MLOps-Architecture" name="MLOps Serving and Training Architecture">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                
                <!-- Client / User -->
                <mxCell id="user_box" value="Client / REST API User&#xa;(Train / Predict / Check Status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="260" width="180" height="70" as="geometry"/>
                </mxCell>

                <!-- FastAPI Server -->
                <mxCell id="fastapi" value="FastAPI Server&#xa;(Port 8000)&#xa;• /api/v1/train/enqueue&#xa;• /api/v1/predict&#xa;• /api/v1/predict/{job_id}" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="300" y="235" width="200" height="120" as="geometry"/>
                </mxCell>

                <!-- Redis Queue & Store -->
                <mxCell id="redis" value="Redis Queue &amp; Store&#xa;(Port 6379)&#xa;• scheduled_training_queue&#xa;• inference_jobs_queue&#xa;• predict_job:{job_id}" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="305" y="470" width="190" height="130" as="geometry"/>
                </mxCell>

                <!-- Trainer Worker -->
                <mxCell id="trainer_worker" value="Trainer Worker (GPU)&#xa;(PyTorch / Hugging Face)&#xa;• Poll scheduled jobs&#xa;• Train NER model&#xa;• Stream metrics to MLflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="475" width="200" height="110" as="geometry"/>
                </mxCell>

                <!-- Inference Worker -->
                <mxCell id="inference_worker" value="Inference Worker&#xa;(PyTorch / Transformers)&#xa;• Poll inference_jobs_queue&#xa;• Load model from MLflow/MinIO&#xa;• Save prediction to Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="640" y="310" width="200" height="110" as="geometry"/>
                </mxCell>

                <!-- MLflow Tracking Server -->
                <mxCell id="mlflow" value="MLflow Tracking Server&#xa;(Port 5000)&#xa;• Experiment Tracking&#xa;• Model Registry &amp; Metrics&#xa;• Artifact Logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="960" y="380" width="210" height="120" as="geometry"/>
                </mxCell>

                <!-- PostgreSQL -->
                <mxCell id="postgres" value="PostgreSQL DB&#xa;(Port 5432)&#xa;[MLflow Backend Store]&#xa;• Runs, Metrics, Params, Tags" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#bac8d3;strokeColor=#23445d;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="290" width="150" height="110" as="geometry"/>
                </mxCell>

                <!-- MinIO Object Storage -->
                <mxCell id="minio" value="MinIO Object Storage&#xa;(Port 9000 / 9001)&#xa;• datasets bucket&#xa;• models bucket&#xa;• mlflow artifact root" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="965" y="150" width="200" height="130" as="geometry"/>
                </mxCell>

                <!-- HuggingFace Dataset -->
                <mxCell id="huggingface" value="Hugging Face&#xa;(Dataset: CoNLL-2003)" style="ellipse;cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="980" y="20" width="170" height="80" as="geometry"/>
                </mxCell>

                <!-- Edges & Connectors -->
                <!-- User to FastAPI -->
                <mxCell id="e_user_fastapi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#4A90E2;" parent="1" source="user_box" target="fastapi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_user_fastapi_lbl" value="HTTP POST / GET" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_user_fastapi" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset"/></mxGeometry>
                </mxCell>

                <!-- FastAPI to Redis -->
                <mxCell id="e_fastapi_redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#b85450;" parent="1" source="fastapi" target="redis" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_fastapi_redis_lbl" value="Enqueue Jobs &amp; Read Results" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=10;" parent="e_fastapi_redis" vertex="1" connectable="0">
                    <mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
                </mxCell>

                <!-- Redis to Trainer Worker -->
                <mxCell id="e_redis_trainer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#b85450;" parent="1" source="redis" target="trainer_worker" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
